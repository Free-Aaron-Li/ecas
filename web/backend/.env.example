# ECAS 后端环境变量示例
#
# 用法：`cp .env.example .env`（`.env` 已在 .gitignore 里，不会进仓库），
# 或者直接在命令行里 `ECAS_XXX=... .venv/bin/python -m uvicorn app.main:app`。
# 变量名一律带前缀 `ECAS_`（见 app/settings.py）。

# ── 访问令牌（对外发布必设）─────────────────────────────
# 留空 = 开发模式（不校验），只适合监听 127.0.0.1 的本机开发；
# 启动日志会明确写出「令牌校验：未启用」，避免"以为开了其实没开"。
# 生成一串够长的随机值，例如：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ECAS_AUTH_TOKEN=

# ── 数据库（本地 Homebrew PostgreSQL 18：unix socket + trust，无口令）──
# ECAS_DSN=postgresql://ecas@/ecas_dev?host=/tmp&port=55432

# ── HTTP ────────────────────────────────────────────────
# ECAS_HOST=127.0.0.1
# ECAS_PORT=8080

# ── 补偿口径（现役：加性 +0.48 个浓度点，不是 ×1.003）────
#   ↑ 2026-09-26 现场标定值。改这里会**同时**影响看板、区间统计、报警判定与班次报表。
# ECAS_OFFSET_MODE=add
# ECAS_OFFSET_CONC=0.48

# ── 时区（班次报表按它切班）──────────────────────────────
# 白班 08:00–20:00、夜班 20:00–次日 08:00 —— 这里的「早八点」按哪个时区算。
# 默认 Asia/Shanghai。服务器常跑 UTC，显式写出来是为了不依赖系统时区。
# ⚠️ 非法时区名会让后端**启动即失败**（故意 fail-fast：静默回退 UTC 更难发现）。
# ECAS_TZ=Asia/Shanghai
