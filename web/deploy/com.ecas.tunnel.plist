<?xml version="1.0" encoding="UTF-8"?>
<!--
  ECAS 云端看板的常驻 SSH 隧道（macOS LaunchAgent）。

  ★ 2026-10-26 先生令：网站只允许先生这台 Mac 访问，其他一律禁止。
    云端后端已改绑 127.0.0.1:18080（web/deploy/ubuntu/lockdown-rebind.sh），
    叠加网/公网/VPC 隧道全部不可达；本隧道是**唯一**入口：
    本机 127.0.0.1:18080 →（SSH，身份＝本机私钥）→ ubuntu-Super-Server 的回环 127.0.0.1:18080。

  装法：
    cp web/deploy/com.ecas.tunnel.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ecas.tunnel.plist
  改完要重载：
    launchctl bootout gui/$(id -u)/com.ecas.tunnel
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ecas.tunnel.plist
  卸法：
    launchctl bootout gui/$(id -u)/com.ecas.tunnel
    rm ~/Library/LaunchAgents/com.ecas.tunnel.plist
  说明：本机 8080 归本地开发后端，云端看板隧道固定用 18080；KeepAlive 让它在掉线后自动重连，
  开机/登录即启动 ⇒ 不依赖任何终端窗口，关掉 Ghostty 也不影响。
  验收：curl -sS -o /dev/null -w '%{http_code}\n' http://127.0.0.1:18080/healthz  → 200
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ecas.tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-o</string><string>BatchMode=yes</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
    <string>-o</string><string>ServerAliveInterval=30</string>
    <string>-o</string><string>ServerAliveCountMax=3</string>
    <string>-o</string><string>ControlMaster=no</string>
    <string>-o</string><string>ControlPath=none</string>
    <string>-o</string><string>ConnectTimeout=10</string>
    <string>-L</string><string>18080:127.0.0.1:18080</string>
    <string>ubuntu-super</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/lijc/.dsh/logs/ecas-tunnel.log</string>
  <key>StandardErrorPath</key><string>/Users/lijc/.dsh/logs/ecas-tunnel.err</string>
</dict>
</plist>
