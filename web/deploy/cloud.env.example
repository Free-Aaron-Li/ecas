# 云端 /root/ecas-web/ecas-web.env 的模板（真实文件权限 600，含令牌，不要提交）
# 改完：systemctl restart ecas-web
ECAS_DSN=postgresql://ecas@127.0.0.1:5432/ecas
PGPASSFILE=/root/.pgpass
ECAS_MODEL_NAME=DPRO-66
ECAS_HOST=127.0.0.1
ECAS_PORT=8080
ECAS_AUTH_TOKEN=<用 python3 -c "import secrets;print(secrets.token_urlsafe(32))" 生成>
ECAS_ALARM_SCAN=1
ECAS_ALARM_SCAN_SECONDS=60
