[Unit]
# ECAS 本地看门狗（配合 ecas-watchdog.timer，每 5 分钟跑一次）
Description=ECAS 本地看门狗（数据断流 / 容器 / 看板 / 备份 / 磁盘）
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ecas
ExecStart=/opt/ecas/watchdog/ecas-watchdog.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
