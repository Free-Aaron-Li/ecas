# ============================================================================
# ECAS · Ubuntu Super Server 测试栈的环境变量模板
#
# ⚠️ 真值不要手写在这里：`deploy.sh` 会从密钥卷（/Volumes/keys/ecas/）读出
#    PG_PASSWORD / AUTH_TOKEN 并与其它非敏感值一起写成 `/opt/ecas/.env`（权限 600）。
#    这个文件只是「有哪些键、各自什么含义」的说明。
# ============================================================================

# —— 新建的测试数据库（容器内网，不对外发布端口）——
PG_USER=ecas
PG_NAME=ecas
PG_PASSWORD=<deploy.sh 从密钥卷写入；不落仓库、不回显>

# —— 网页访问令牌（32 字节随机串，浏览器 ?token=... 或 Cookie）——
AUTH_TOKEN=<deploy.sh 从密钥卷写入>

# —— 口径（与现场标定一致）——
MODEL_NAME=DPRO-66
OFFSET_MODE=add
#: ⭐ 0.48 是 2026-09-26 现场 7 组比对后的标定值；旧的 0.5 / 0.3 都不是当前口径
OFFSET_CONC=0.48

# —— broker（2026-11-03 起在本机 ecas-mosquitto）——
# 1883 只听 127.0.0.1（rtu-master 往里发 dpro66），8884/TLS 听 10.10.10.11。
# 云端 10.10.10.123 现在只做 DTU 的内核转发，8884 上**没有** broker 监听：
# 写 10.10.10.123 会让采集器被立刻 EOF（2026-11-03 断采 19 小时、11-04 又断 15 分钟）。
# server.crt 的 SAN 仅 IP:124.222.122.146 / IP:127.0.0.1 / DNS:VM-0-13-opencloudos，
# 没有 mesh 地址 ⇒ 关主机名校验，改用「CA 链校验 + 证书指纹钉扎」：
#   MQTT_CERT_SHA256 = leaf 证书的 SHA-256，采集器连上就比对，不符即拒绝订阅（fail closed）。
# 取当前指纹（换证书后必须更新本值）：
#   ssh ubuntu-super 'openssl x509 -in /opt/ecas/mqtt/certs/server.crt -noout -fingerprint -sha256'
MQTT_HOST=10.10.10.11
MQTT_PORT=8884
MQTT_TOPIC=dpro66
#: 只读账号：ACL 里只允许 `topic read dpro66`
MQTT_USER=ecas-monitor
#: 2026-09-26 签发的 server.crt（有效期至 2036-09-23；序列号 40DE409E…FE2B2）
MQTT_CERT_SHA256=B6:4B:8D:3A:37:E4:39:AA:61:0B:BD:02:D1:9C:66:0D:EB:4C:11:CD:C8:77:DE:93:1C:AE:0E:72:5D:84:6D:41

# —— 只绑回环 127.0.0.1：外部只能经本机 SSH 隧道访问（2026-10-26 安全收口）——
#    历史值 10.10.10.11 是叠加网地址（任何 mesh 成员都能访问）⇒ 已作废，勿改回。
BIND_IP=127.0.0.1

# —— 构建加速（目标机连不上 Docker Hub 与默认 PyPI）——
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
