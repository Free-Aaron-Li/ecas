# ============================================================================
# ECAS · Ubuntu Super Server 测试栈的环境变量模板
#
# ⚠️ 真值不要手写在这里：`deploy.sh` 会从密钥卷（/Volumes/keys/ecas/）读出
#    PG_PASSWORD / AUTH_TOKEN 并与其它非敏感值一起写成 `/opt/ecas/.env`（权限 600）。
#    这个文件只是「有哪些键、各自什么含义」的说明。
# ============================================================================

# —— 新建的测试数据库（容器内网，不对外发布端口）——
PG_USER=ecas
PG_NAME=ecas
PG_PASSWORD=<deploy.sh 从密钥卷写入；不落仓库、不回显>

# —— 网页访问令牌（32 字节随机串，浏览器 ?token=... 或 Cookie）——
AUTH_TOKEN=<deploy.sh 从密钥卷写入>

# —— 口径（与现场标定一致）——
MODEL_NAME=DPRO-66
OFFSET_MODE=add
#: ⭐ 0.48 是 2026-09-26 现场 7 组比对后的标定值；旧的 0.5 / 0.3 都不是当前口径
OFFSET_CONC=0.48

# —— 云端 broker（腾讯云 Mosquitto）——
# 8884 是 TLS 监听，但**未放行腾讯云安全组**（云端配置注释：「未放行安全组 ⇒ 公网不可达，
# 仅作就绪备用」）⇒ 测试机走公网连不上（实测 timeout）；8883 是明文口（现场 DTU 用），不用。
# 因此走 **mesh 连云端的 mesh 地址 10.10.10.123:8884**（目标机实测可达）。
# 该地址不在 server.crt 的 SAN 里（SAN 仅 IP:124.222.122.146 / IP:127.0.0.1 /
# DNS:VM-0-13-opencloudos）⇒ 关掉主机名校验，改用「CA 链校验 + 证书指纹钉扎」：
#   MQTT_CERT_SHA256 = leaf 证书的 SHA-256，采集器每次连上都比对，不符就拒绝订阅。
# 取当前指纹（云端重签证书后必须更新本值，否则采集器 fail closed）：
#   ssh ecas 'openssl x509 -in /etc/mosquitto/certs/server.crt -noout -fingerprint -sha256'
MQTT_HOST=10.10.10.123
MQTT_PORT=8884
MQTT_TOPIC=dpro66
#: 只读账号：ACL 里只允许 `topic read dpro66`
MQTT_USER=ecas-monitor
#: 2026-09-26 签发的 server.crt（有效期至 2036-09-23；序列号 40DE409E…FE2B2）
MQTT_CERT_SHA256=B6:4B:8D:3A:37:E4:39:AA:61:0B:BD:02:D1:9C:66:0D:EB:4C:11:CD:C8:77:DE:93:1C:AE:0E:72:5D:84:6D:41

# —— 只绑 easytier mesh 网卡，公网/局域网都到不了 8080 ——
BIND_IP=10.10.10.11

# —— 构建加速（目标机连不上 Docker Hub 与默认 PyPI）——
PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
